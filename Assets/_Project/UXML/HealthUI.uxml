    <ui:VisualElement name="HealthContainer" style="width: 200px; height: 60px; background-color: rgb(0, 0, 0); position: relative; align-content: flex-start; align-items: stretch; justify-content: flex-start; align-self: center; flex-direction: column; flex-wrap: nowrap; -unity-text-align: upper-left; bottom: -58%;">
