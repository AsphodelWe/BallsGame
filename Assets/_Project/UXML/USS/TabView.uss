.unity-tab__header {
    background-color: rgb(255, 255, 255);
    padding: 10px 10px 0 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(60, 60, 60);
    width: 51%;
}

.unity-tab {
    font-size: 28px;
    color: rgb(0, 0, 0);
    padding: 12px 24px;
    margin-right: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background-color: rgba(255, 0, 0, 0);
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-background-image-tint-color: rgb(255, 0, 0);
}

.unity-tab--active {
    color: white;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 200, 0);
}

.unity-tab__header-label {
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    font-size: 47px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&guid=8a2b9e2a607dd2143b58c44bc32410b4&type=3#Electronic Highway Sign");
}
