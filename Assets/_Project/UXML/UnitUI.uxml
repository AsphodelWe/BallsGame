    <ui:VisualElement name="RootElement" style="flex-grow: 1; flex-direction: column; align-items: stretch; justify-content: flex-start; align-self: stretch; align-content: auto; flex-wrap: nowrap; height: auto;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 100%; height: 6%; position: relative; top: auto; left: auto; align-self: center; margin-top: 2%; flex-direction: row; justify-content: space-between;">
            <ui:Button text="Clear Ghosts" name="ClearButton" class="buttonAnimation" style="width: 20%; height: 100%; background-color: rgba(255, 255, 255, 0); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgb(0, 104, 255); border-right-color: rgb(0, 104, 255); border-top-color: rgb(0, 104, 255); border-bottom-color: rgb(0, 104, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 35px; text-overflow: clip; -unity-font-style: normal; background-image: url(&quot;project://database/Assets/FreeButtonSet/Textures/controls/toggle_bg_50.png?fileID=2800000&amp;guid=bd38c9e672875e046aaf4d5369356d63&amp;type=3#toggle_bg_50&quot;); white-space: pre-wrap; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Oswald-Bold.ttf?fileID=12800000&amp;guid=c9f6d0e7bc8541498c9a4799ba184ede&amp;type=3#Oswald-Bold&quot;);"/>
            <ui:Button text="Battle" name="BattleButton" parse-escape-sequences="false" display-tooltip-when-elided="true" triple-click-selects-line="true" double-click-selects-word="true" selectable="false" focusable="false" emoji-fallback-support="true" enable-rich-text="true" enabled="false" class="buttonAnimation" style="flex-grow: 0; width: 40%; height: 100%; justify-content: flex-start; align-self: flex-start; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-color: rgba(255, 235, 12, 0); font-size: 60%; -unity-text-outline-color: rgb(0, 0, 0); overflow: visible; visibility: visible; display: flex; background-size: 100% 100%; flex-direction: row; top: auto; align-items: stretch; position: relative; flex-wrap: nowrap; background-image: url(&quot;project://database/Assets/FreeButtonSet/Textures/buttons/button_100.png?fileID=2800000&amp;guid=47eaa4f43430bf14f996b113a313b0cc&amp;type=3#button_100&quot;); -unity-background-image-tint-color: rgb(255, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Anton.ttf?fileID=12800000&amp;guid=997a43b767814dd0a7642ec9b78cba41&amp;type=3#Anton&quot;);"/>
            <ui:Button text="Map Settings" name="MapPreferenceButton" class="buttonAnimation" style="width: 20%; height: 100%; align-self: flex-start; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(0, 192, 255); border-right-color: rgb(0, 192, 255); border-top-color: rgb(0, 192, 255); border-bottom-color: rgb(0, 192, 255); background-color: rgba(255, 255, 255, 0); font-size: 35px; flex-direction: row; background-image: url(&quot;project://database/Assets/FreeButtonSet/Textures/controls/toggle_bg_200.png?fileID=2800000&amp;guid=c8dec52db7cb0f148b53038d975761ea&amp;type=3#toggle_bg_200&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; white-space: pre-wrap; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Anton.ttf?fileID=12800000&amp;guid=997a43b767814dd0a7642ec9b78cba41&amp;type=3#Anton&quot;); text-overflow: clip;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContainer" style="flex-grow: 0; position: relative; top: auto; right: auto; margin-top: 2%; margin-right: 0%; align-items: stretch; justify-content: space-between; align-self: auto; align-content: flex-start; visibility: visible; height: 25%; flex-direction: row-reverse;">
            <ui:VisualElement name="MapPanel" style="flex-grow: 0; top: auto; width: 50%; height: 100%; background-color: rgb(0, 235, 255); visibility: hidden; justify-content: space-around; overflow: visible; align-self: stretch; display: flex; flex-direction: column; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-position-x: center; -unity-slice-type: sliced; background-image: url(&quot;project://database/Assets/_Project/Sprites/UI/ButtonTemplate.png?fileID=2800000&amp;guid=110064db9b700444fb9e933e83593984&amp;type=3#ButtonTemplate&quot;); -unity-background-image-tint-color: rgb(0, 205, 255);">
                <ui:VisualElement name="MapScaleSliderContainer" style="flex-grow: 1;">
                    <ui:Label text="MAP SCALE" name="Label" style="-unity-text-align: upper-center; background-color: rgb(255, 255, 255); font-size: 45px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Anton.ttf?fileID=12800000&amp;guid=997a43b767814dd0a7642ec9b78cba41&amp;type=3#Anton&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Slider label="" value="1" high-value="10" name="MapSlider" inverted="false" low-value="0.5" fill="true" direction="Horizontal" class="MySlider" style="align-self: auto; flex-direction: row; justify-content: flex-start; align-items: auto; flex-grow: 1; -unity-text-align: upper-left;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; top: 0%; justify-content: flex-start; align-items: stretch; align-self: auto; align-content: auto;">
                    <ui:Label text="MAP ROTATION" name="Label" style="background-color: rgb(255, 255, 255); font-size: 46px; -unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Anton.ttf?fileID=12800000&amp;guid=997a43b767814dd0a7642ec9b78cba41&amp;type=3#Anton&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); top: 0; margin-bottom: 6%;"/>
                    <ui:Toggle label="" name="IsRotate" class="BattleToggle" style="align-self: center; flex-direction: column; -unity-text-align: upper-left; justify-content: flex-start;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="" name="SettingsCountryButton" class="buttonAnimation" style="background-image: url(&quot;project://database/Assets/Epic%20Toon%20FX/Textures/Symbols/sym_health.png?fileID=2800000&amp;guid=1d7623476e1d0574080413f26a89dfbe&amp;type=3#sym_health&quot;); -unity-background-image-tint-color: rgb(67, 255, 0); background-color: rgba(188, 188, 188, 0); background-size: 100% 100%; width: 10%; height: 20%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-grow: 0; align-self: auto; flex-direction: row;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Spacer" style="flex-grow: 1;"/>
        <ui:ScrollView mode="Horizontal" name="CountryScrollView" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" elasticity="0.1" scroll-deceleration-rate="0" style="flex-grow: 0; position: relative; flex-direction: column; align-self: auto; bottom: auto; top: auto;">
            <ui:VisualElement name="CountryContainer" style="flex-grow: 0; flex-direction: row;"/>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
