<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 30%; height: 6%; position: absolute; top: auto; left: auto; align-self: center; margin-top: 2%;">
            <ui:Button text="Battle" name="BattleButton" parse-escape-sequences="false" display-tooltip-when-elided="true" triple-click-selects-line="true" double-click-selects-word="true" selectable="false" focusable="false" emoji-fallback-support="true" enable-rich-text="true" enabled="false" style="flex-grow: 0; width: 100%; height: 100px; justify-content: flex-start; align-self: center; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-left-radius: 44px; border-top-right-radius: 44px; border-bottom-right-radius: 44px; border-bottom-left-radius: 44px; background-color: rgb(255, 235, 12); font-size: 42%; -unity-text-outline-color: rgb(0, 0, 0); overflow: visible; visibility: visible; display: flex;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:ScrollView name="ScrollView" style="justify-content: flex-start; align-items: stretch; align-content: auto; align-self: auto; flex-direction: column; bottom: auto; left: auto; right: auto; top: auto;">
        <ui:VisualElement name="CountryContainer" style="flex-grow: 1; flex-direction: row; align-self: flex-start; align-content: flex-start; justify-content: flex-start; align-items: auto; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(255, 255, 255, 0); color: rgb(27, 27, 27); cursor: initial; visibility: visible; overflow: visible;"/>
    </ui:ScrollView>
    <ui:VisualElement name="MapScaler" style="flex-grow: 1; position: absolute; top: -17px; right: 47px; margin-top: 5%; margin-right: 0%; align-items: stretch; justify-content: flex-start; align-self: auto; align-content: flex-start; visibility: visible;">
        <ui:Button text="Настройки карты" name="MapPreferenceButton" style="width: 190px; height: 68px; align-self: center; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; border-left-color: rgb(0, 192, 255); border-right-color: rgb(0, 192, 255); border-top-color: rgb(0, 192, 255); border-bottom-color: rgb(0, 192, 255); background-color: rgb(255, 255, 255); font-size: 20px;"/>
        <ui:VisualElement name="MapPanel" style="flex-grow: 1; top: 0%; width: 300px; height: 100px; background-color: rgb(255, 255, 255); visibility: visible; justify-content: space-around; overflow: visible;">
            <ui:Slider label="Slider" value="1" high-value="10" name="MapSlider" inverted="false" low-value="0.5" fill="true" direction="Horizontal"/>
            <ui:Toggle label="Rotate" name="IsRotate" toggle-on-label-click="true"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; position: absolute; top: 2%; left: 9%;">
        <ui:Button text="Очистить призраков" name="ClearButton" style="width: 190px; height: 68px; background-color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgb(0, 104, 255); border-right-color: rgb(0, 104, 255); border-top-color: rgb(0, 104, 255); border-bottom-color: rgb(0, 104, 255); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; font-size: 18px; text-overflow: clip; -unity-font-style: normal;"/>
    </ui:VisualElement>
</ui:UXML>
