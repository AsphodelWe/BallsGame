.arrow {
    background-image: url("project://database/Assets/Scripts/Arrow.png?fileID=2800000&guid=4f3f952e336225d41bd8d87f03d20676&type=3#Arrow");
    background-color: rgba(0, 0, 0, 0);
    align-items: stretch;
    justify-content: flex-start;
    align-self: center;
    align-content: auto;
    width: 100px;
    height: 50px;
    transition-duration: 0.35s;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.arrow:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(229, 255, 38);
    background-color: rgba(0, 255, 34, 0);
}

.arrow:active {
    -unity-background-image-tint-color: rgb(35, 255, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Scripts/Arrow.png?fileID=-4346244404228752641&guid=4f3f952e336225d41bd8d87f03d20676&type=3#Arrow_0");
}
